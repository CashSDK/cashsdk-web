{
  "name": "cashsdk-react",
  "version": "0.1.0-alpha.0",
  "description": "React bindings for CashSDK web customer sessions and entitlements",
  "author": "CashSDK <support@cashsdk.com>",
  "homepage": "https://docs.cashsdk.com/sdk/web",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/CashSDK/cashsdk-web.git",
    "directory": "packages/cashsdk-react"
  },
  "bugs": {
    "url": "https://github.com/CashSDK/cashsdk-web/issues"
  },
  "keywords": [
    "cashsdk",
    "react",
    "hooks",
    "subscriptions",
    "entitlements",
    "paywall"
  ],
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "files": [
    "dist",
    "src",
    "README.md",
    "LICENSE"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "node --test test/*.test.mjs",
    "lint": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "cashsdk-web": "workspace:*"
  },
  "peerDependencies": {
    "react": "^18.0.0 || ^19.0.0"
  },
  "devDependencies": {
    "typescript": "^5.7.3",
    "@types/react": "^19.1.14",
    "react": "19.1.3",
    "react-dom": "19.1.3",
    "@types/react-dom": "^19.1.9"
  },
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "publishConfig": {
    "access": "public",
    "tag": "next",
    "provenance": true
  }
}
