{
  "name": "cashsdk-node",
  "version": "0.1.0-alpha.0",
  "description": "CashSDK server sessions and signed webhook verification",
  "author": "CashSDK <support@cashsdk.com>",
  "homepage": "https://docs.cashsdk.com/sdk/web",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/CashSDK/cashsdk-web.git",
    "directory": "packages/cashsdk-node"
  },
  "bugs": {
    "url": "https://github.com/CashSDK/cashsdk-web/issues"
  },
  "keywords": [
    "cashsdk",
    "server",
    "webhooks",
